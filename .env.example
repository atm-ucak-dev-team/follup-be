# Jira Email Automation Backend - Environment Configuration
# Copy this file to .env and fill in your values
#
# Quick Start:
# 1. cp .env.example .env
# 2. Replace placeholder values with your actual configuration
# 3. Run: ./bin/server

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Port for the HTTP server (default: 8080)
APP_PORT=8080

# Environment: development, staging, or production
APP_ENV=development

# ===========================================
# ENCRYPTION CONFIGURATION (REQUIRED)
# ===========================================
# AES-256-GCM encryption key for password storage
# MUST be exactly 32 characters (256 bits)
# Generate with: openssl rand -base64 24 | head -c 32
AES_SECRET_KEY=32-char-secret-key-here-exactly!!

# JWT secret for token validation (minimum 32 characters recommended)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-minimum-32-chars

# ===========================================
# DRAGONFLYDB CONFIGURATION (REQUIRED)
# ===========================================
# DragonflyDB server address (Redis-compatible)
DRAGONFLY_ADDR=localhost:6379

# DragonflyDB password (leave empty if no password)
DRAGONFLY_PASSWORD=

# DragonflyDB database number (0-15)
DRAGONFLY_DB=0

# ===========================================
# POSTGRESQL CONFIGURATION (OPTIONAL)
# ===========================================
# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
# Leave empty to skip PostgreSQL initialization
POSTGRES_DSN=postgres://user:pass@localhost:5432/dbname

# ===========================================
# JIRA OAUTH CONFIGURATION (REQUIRED)
# ===========================================
# Your Jira OAuth 2.0 credentials
# Get from: https://developer.atlassian.com/console/
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# OAuth redirect URI (must match what you registered in Jira)
# Should point to your callback endpoint
JIRA_REDIRECT_URI=http://localhost:8080/auth/jira/callback

# OAuth operations (authorization, token exchange)
JIRA_AUTH_BASE_URL=https://auth.atlassian.com

# API operations (user info, issues, etc.)
JIRA_API_BASE_URL=https://api.atlassian.com

# Frontend callback URL (where users are redirected after OAuth success)
# OAuth tokens will be passed as query parameters to this URL
FRONTEND_CALLBACK_URL=http://localhost:3000/jira-callback

# ===========================================
# EMAIL PROVIDER CONFIGURATION
# ===========================================
# IMAP settings for receiving emails
# Gmail: imap.gmail.com:993
# Outlook: outlook.office365.com:993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# SMTP settings for sending emails
# Gmail: smtp.gmail.com:587
# Outlook: smtp.office365.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ===========================================
# IMAP POLLING CONFIGURATION
# ===========================================
# How often to poll for email replies (in seconds)
# Default: 300 (5 minutes)
# Minimum: 60 (1 minute)
IMAP_POLL_INTERVAL_SECONDS=300
